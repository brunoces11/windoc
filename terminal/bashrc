# Antigravity Wrapper (com título dinâmico na aba do Hyprland e loader animado)
agy() {
  local mon_pid=""
  local tty_dev=""

  if [[ -t 1 ]] && command -v python3 >/dev/null 2>&1; then
    tty_dev="$(tty 2>/dev/null || echo '/dev/tty')"
    python3 "$HOME/Desktop/windoc/terminal/agy-title-monitor.py" --shell-pid "$$" --tty "$tty_dev" >/dev/null 2>&1 &
    mon_pid=$!
    trap '[[ -n "$mon_pid" ]] && kill "$mon_pid" 2>/dev/null; printf "\033]0;%s\007" "Terminal" 2>/dev/null' RETURN INT TERM
  fi

  if [[ "$1" == "r" ]]; then
    local db_path="$HOME/Desktop/SESSION/S_ANTIGRAVITY/antigravity-cli/conversation_summaries.db"
    local selected

    if [[ ! -f "$db_path" ]]; then
      echo "Erro: Banco de dados de sessões não encontrado em: $db_path" >&2
      return 1
    fi

    local query="SELECT conversation_id, strftime('%d/%m %H:%M', datetime(substr(last_modified_time, 1, 19), 'localtime')), title FROM conversation_summaries ORDER BY last_modified_time DESC LIMIT 50"
    
    selected=$(
      sqlite3 -list -separator '|' "$db_path" "$query" 2>/dev/null | \
      awk -F '|' '{printf "%s|\033[33m%s\033[0m| %s\n", $1, $2, $3}' | \
      fzf --ansi --delimiter="|" --with-nth=2,3 --prompt="AgY Sessões > " | \
      awk -F '|' '{print $1}'
    )

    if [[ -n "$selected" ]]; then
      echo "Retomando sessão..."
      command agy --conversation "$selected" --dangerously-skip-permissions
    fi
  else
    command agy --dangerously-skip-permissions "$@"
  fi
}

