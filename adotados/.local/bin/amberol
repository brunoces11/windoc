#!/usr/bin/env bash
# Amberol wrapper for Omarchy / WinDoc / Amberol Deskband
# Automatically loads the persisted default folder if opened without arguments,
# persists any folder opened by the user, and handles D-Bus activation cleanly.

set -e

DESKBAND_AMBEROL_PREFIX="$HOME/.local/lib/amberol-deskband"
DESKBAND_AMBEROL_BIN="$DESKBAND_AMBEROL_PREFIX/bin/amberol"
if [ -x "$DESKBAND_AMBEROL_BIN" ]; then
    REAL_AMBEROL="$DESKBAND_AMBEROL_BIN"
    DESKBAND_SCHEMA_DIR="$DESKBAND_AMBEROL_PREFIX/share/glib-2.0/schemas"
    if [ -d "$DESKBAND_SCHEMA_DIR" ]; then
        export GSETTINGS_SCHEMA_DIR="$DESKBAND_SCHEMA_DIR"
    fi
else
    REAL_AMBEROL="/usr/bin/amberol"
fi
if [ "${AMBEROL_DESKBAND_PRINT_BACKEND:-0}" = 1 ]; then
    printf '%s\n' "$REAL_AMBEROL"
    exit 0
fi
if [ ! -x "$REAL_AMBEROL" ]; then
    REAL_AMBEROL="$(which -a amberol 2>/dev/null | grep -v "$HOME/.local/bin/amberol" | head -n 1 || true)"
fi

if [ -z "$REAL_AMBEROL" ] || [ ! -x "$REAL_AMBEROL" ]; then
    echo "ERROR: Real amberol binary not found in /usr/bin or PATH" >&2
    exit 1
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/amberol-deskband"
CONFIG_FILE="$CONFIG_DIR/config.json"

get_default_folder() {
    if [ -f "$CONFIG_FILE" ]; then
        python3 -c "import json, os, sys; d=json.load(open('$CONFIG_FILE')); f=d.get('default_folder',''); sys.stdout.write(f if os.path.isdir(f) else '')" 2>/dev/null || true
    fi
}

save_default_folder() {
    local target="$1"
    if [ -d "$target" ]; then
        python3 -c "import json, os, sys; from pathlib import Path; p=str(Path(sys.argv[1]).resolve()); Path(sys.argv[2]).parent.mkdir(parents=True, exist_ok=True); json.dump({'default_folder': p}, open(sys.argv[2], 'w'), indent=2); open(sys.argv[2], 'a').write('\n')" "$target" "$CONFIG_FILE" 2>/dev/null || true
    fi
}

# 1. Check if invoked as D-Bus service (--gapplication-service)
for arg in "$@"; do
    if [ "$arg" = "--gapplication-service" ]; then
        # Spawn background watcher to feed the default folder once D-Bus service is ready
        (
            DEF="$(get_default_folder)"
            if [ -n "$DEF" ]; then
                for i in {1..25}; do
                    if busctl --user status io.bassi.Amberol >/dev/null 2>&1; then
                        sleep 0.2
                        URI=$(python3 -c "from pathlib import Path; print(Path('$DEF').as_uri())" 2>/dev/null || true)
                        if [ -n "$URI" ]; then
                            busctl --user call io.bassi.Amberol /io/bassi/Amberol org.freedesktop.Application Open "asa{sv}" 1 "$URI" 0 >/dev/null 2>&1 || true
                        fi
                        break
                    fi
                    sleep 0.2
                done
            fi
        ) &
        exec "$REAL_AMBEROL" "$@"
    fi
done

# 2. Check if a folder was passed as argument (e.g. amberol /path/to/folder)
for arg in "$@"; do
    if [ -d "$arg" ]; then
        save_default_folder "$arg"
        break
    fi
done

# 3. If called with NO arguments (or only empty string)
HAS_REAL_ARGS=0
for arg in "$@"; do
    if [ -n "$arg" ]; then
        HAS_REAL_ARGS=1
        break
    fi
done

if [ $HAS_REAL_ARGS -eq 0 ]; then
    DEFAULT_FOLDER="$(get_default_folder)"
    if [ -n "$DEFAULT_FOLDER" ] && [ -d "$DEFAULT_FOLDER" ]; then
        # If Amberol is already running:
        if busctl --user status io.bassi.Amberol >/dev/null 2>&1 || pgrep -x "amberol" >/dev/null 2>&1; then
            # Ensure folder is loaded via D-Bus if Amberol was empty
            URI=$(python3 -c "from pathlib import Path; print(Path('$DEFAULT_FOLDER').as_uri())" 2>/dev/null || true)
            if [ -n "$URI" ]; then
                busctl --user call io.bassi.Amberol /io/bassi/Amberol org.freedesktop.Application Open "asa{sv}" 1 "$URI" 0 >/dev/null 2>&1 || true
            fi
            # This wrapper is also used by the compact Deskband/autostart.
            # Keep the existing MPRIS service running without activating its GTK window.
            exit 0
        else
            # Launch new instance with default folder loaded
            exec "$REAL_AMBEROL" "$DEFAULT_FOLDER"
        fi
    fi
fi

# Fallback: execute with original arguments
exec "$REAL_AMBEROL" "$@"
