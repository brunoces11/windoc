#!/usr/bin/env python3
"""
WinDoc Text-to-Speech (TTS) Toggle com Overlay Visual (Estilo Voxtype)
Ativado por tecla de atalho (ex: PAUSE).
Lê o texto selecionado na tela (Kitty, navegador ou qualquer janela) usando Edge-TTS (pt-BR).
Exibe uma cápsula flutuante (OSD) no topo da tela com transição de estados:
- Cinza + Spinner enquanto conecta e sintetiza.
- Azul + Onda sonora enquanto reproduz.
- Fecha automaticamente ao terminar ou ao apertar PAUSE novamente (Stop/Toggle).
"""

import os
import re
import signal
import subprocess
import sys
import tempfile

PID_FILE = "/tmp/windoc-tts.pid"
DEFAULT_VOICE = os.environ.get("WINDOC_TTS_VOICE", "pt-BR-AntonioNeural")


def notify(title: str, message: str, timeout_ms: int = 2000):
    try:
        subprocess.run(
            ["notify-send", "-a", "WinDoc TTS", "-t", str(timeout_ms), title, message],
            check=False,
        )
    except Exception:
        pass


def stop_existing_playback() -> bool:
    """Se já houver uma reprodução em andamento, interrompe e retorna True."""
    stopped = False
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            try:
                pgid = os.getpgid(pid)
                os.killpg(pgid, signal.SIGTERM)
            except Exception:
                os.kill(pid, signal.SIGTERM)
            stopped = True
        except (ProcessLookupError, ValueError):
            pass
        except Exception:
            pass
        finally:
            if os.path.exists(PID_FILE):
                try:
                    os.remove(PID_FILE)
                except Exception:
                    pass

    # Garante encerramento de processos filhos e OSD
    try:
        subprocess.run(["hyprctl", "eval", 'pcall(function() hl.unbind("Escape") end)'], check=False)
        subprocess.run(["pkill", "-f", "windoc-tts-osd"], check=False)
        res = subprocess.run(["pgrep", "-f", "edge-tts.*pt-BR"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            subprocess.run(["pkill", "-f", "edge-tts.*pt-BR"], check=False)
            stopped = True
    except Exception:
        pass

    if stopped:
        notify("🔇 TTS", "Leitura interrompida", 1200)
    return stopped


def get_selected_text() -> str:
    """Captura o texto selecionado (Primary Selection) ou da área de transferência."""
    # 1. Tenta a seleção primária (texto destacado com mouse/cursor no Kitty/Wayland)
    try:
        res = subprocess.run(
            ["wl-paste", "--primary"],
            capture_output=True,
            text=True,
            timeout=1,
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout
    except Exception:
        pass

    # 2. Se a seleção primária estiver vazia, tenta a área de transferência normal
    try:
        res = subprocess.run(
            ["wl-paste"],
            capture_output=True,
            text=True,
            timeout=1,
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout
    except Exception:
        pass

    return ""


def clean_markdown_and_formatting(text: str) -> str:
    """Limpa formatação Markdown pesada para tornar a leitura por voz mais natural."""
    text = re.sub(r"```[a-zA-Z0-9_-]*\n[\s\S]*?```", " [bloco de código] ", text)
    text = re.sub(r"`([^`]+)`", r"\1", text)
    text = re.sub(r"^\s*#{1,6}\s+", "", text, flags=re.MULTILINE)
    text = re.sub(r"\*{1,3}([^*]+)\*{1,3}", r"\1", text)
    text = re.sub(r"_{1,3}([^_]+)_{1,3}", r"\1", text)
    text = re.sub(r"^\s*>\s*", "", text, flags=re.MULTILINE)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)
    text = re.sub(r"https?://\S+", "link", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def main():
    if stop_existing_playback():
        sys.exit(0)

    raw_text = get_selected_text()
    if not raw_text or not raw_text.strip():
        notify("TTS", "Nenhum texto selecionado", 2000)
        sys.exit(0)

    clean_text = clean_markdown_and_formatting(raw_text)
    if not clean_text:
        notify("TTS", "Texto vazio após limpeza", 2000)
        sys.exit(0)

    # Cria seu próprio grupo de processos para que SIGTERM feche filhos e OSD
    try:
        os.setpgrp()
    except Exception:
        pass

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    # Inicia o overlay visual (OSD) no milissegundo 0 (Estado 1: Cinza + Conectando)
    osd_proc = None
    try:
        osd_proc = subprocess.Popen(
            ["windoc-tts-osd"],
            stdin=subprocess.PIPE,
            text=True,
        )
        # Habilita tecla ESC globalmente no Hyprland enquanto o TTS estiver ativo
        subprocess.run(
            ["hyprctl", "eval", 'pcall(function() hl.bind("Escape", hl.dsp.exec_cmd("windoc-tts")) end)'],
            check=False,
        )
    except Exception:
        osd_proc = None

    temp_text_path = None
    temp_mp3_path = None

    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".txt", delete=False) as tf:
            tf.write(clean_text)
            temp_text_path = tf.name

        with tempfile.NamedTemporaryFile("wb", suffix=".mp3", delete=False) as mf:
            temp_mp3_path = mf.name

        # Fase de Síntese Neural na Nuvem
        res = subprocess.run(
            [
                "edge-tts",
                f"--voice={DEFAULT_VOICE}",
                f"--file={temp_text_path}",
                f"--write-media={temp_mp3_path}",
            ],
            check=False,
        )

        if res.returncode == 0 and os.path.exists(temp_mp3_path) and os.path.getsize(temp_mp3_path) > 0:
            # Transiciona o OSD para o Estado 2 (Azul + Onda Sonora)
            if osd_proc and osd_proc.stdin:
                try:
                    preview = clean_text.replace("\n", " ")[:36]
                    if len(clean_text) > 36:
                        preview += "..."
                    osd_proc.stdin.write(f"PLAYING:{preview}\n")
                    osd_proc.stdin.flush()
                except Exception:
                    pass

            # Reproduz o áudio via mpv
            subprocess.run(
                [
                    "mpv",
                    "--msg-level=all=error",
                    "--no-terminal",
                    temp_mp3_path,
                ],
                check=False,
            )
    finally:
        # Desvincula o atalho ESC temporário
        try:
            subprocess.run(
                ["hyprctl", "eval", 'pcall(function() hl.unbind("Escape") end)'],
                check=False,
            )
        except Exception:
            pass

        # Encerra o OSD
        if osd_proc:
            try:
                if osd_proc.stdin:
                    osd_proc.stdin.write("QUIT\n")
                    osd_proc.stdin.flush()
                osd_proc.terminate()
                osd_proc.wait(timeout=0.4)
            except Exception:
                pass

        if temp_text_path and os.path.exists(temp_text_path):
            try:
                os.remove(temp_text_path)
            except Exception:
                pass

        if temp_mp3_path and os.path.exists(temp_mp3_path):
            try:
                os.remove(temp_mp3_path)
            except Exception:
                pass

        if os.path.exists(PID_FILE):
            try:
                with open(PID_FILE, "r") as f:
                    stored_pid = int(f.read().strip())
                if stored_pid == os.getpid():
                    os.remove(PID_FILE)
            except Exception:
                pass


if __name__ == "__main__":
    main()
